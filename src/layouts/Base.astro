---
export interface Props {
  title: string;
  description?: string;
  /** Widen the column past the usual 42rem. Only /habits needs this. */
  wide?: boolean;
}
const { title, description = "Owen Medeiros — electrical engineer working on superconducting electronics.", wide = false } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/maths", label: "Maths" },
  { href: "/habits", label: "Habits" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    />
    <style is:global>
      :root {
        --bg: #fdfdfc;
        --fg: #1c1c1a;
        --muted: #6b6b66;
        --accent: #8a4b2d;
        --border: #e5e3de;
        --code-bg: #f4f3f0;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #161615;
          --fg: #e8e6e1;
          --muted: #9a988f;
          --accent: #d99a72;
          --border: #2e2d2a;
          --code-bg: #232220;
        }
      }
      * { box-sizing: border-box; }
      html { font-size: 17px; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: Georgia, "Times New Roman", serif;
        line-height: 1.65;
      }
      .wrap {
        max-width: 42rem;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }
      .wrap.wide { max-width: 52rem; }
      header.site {
        margin-bottom: 3rem;
      }
      header.site .name {
        font-size: 1.05rem;
        font-weight: bold;
        letter-spacing: 0.01em;
        text-decoration: none;
        color: var(--fg);
      }
      nav.site {
        margin-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.1rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 0.85rem;
      }
      nav.site a {
        color: var(--muted);
        text-decoration: none;
      }
      nav.site a:hover { color: var(--fg); }
      nav.site a.active { color: var(--fg); border-bottom: 1px solid var(--accent); }
      main h1 {
        font-size: 1.8rem;
        line-height: 1.25;
        margin: 0 0 1.25rem;
        font-weight: normal;
      }
      main h2 {
        font-size: 1.25rem;
        margin: 2.2rem 0 0.75rem;
        font-weight: bold;
      }
      main h3 {
        font-size: 1.05rem;
        margin: 1.6rem 0 0.5rem;
      }
      a { color: var(--accent); text-underline-offset: 2px; }
      a:hover { color: var(--fg); }
      img, video {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
      }
      figure { margin: 1.5rem 0; }
      figcaption, .caption {
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 0.4rem;
      }
      hr { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }
      blockquote {
        margin: 1.5rem 0;
        padding-left: 1rem;
        border-left: 2px solid var(--border);
        color: var(--muted);
      }
      code {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 0.85em;
        background: var(--code-bg);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }
      pre {
        background: var(--code-bg);
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 0.8rem;
        line-height: 1.5;
      }
      pre code { background: none; padding: 0; font-size: inherit; }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.9rem;
        margin: 1.25rem 0;
      }
      th, td {
        border: 1px solid var(--border);
        padding: 0.4rem 0.6rem;
        text-align: left;
      }
      th { background: var(--code-bg); }
      ul, ol { padding-left: 1.4rem; }
      li { margin: 0.25rem 0; }
      .pub-list li { margin: 0.8rem 0; }
      .pub-venue { color: var(--muted); font-style: italic; }
      /* Habits heatmap. Scoped to /habits, the first of the five pages that
         carry client-side JS — here only for the tooltip. */
      .habits-chart { position: relative; margin: 2rem 0 1rem; }
      .habits-scroll { overflow-x: auto; overflow-y: visible; }
      .habits-chart svg { display: block; }
      .habits-cell { shape-rendering: crispEdges; }
      /* `is-pinned` marks the cell a tap has latched open — touch has no
         hover, so without it there is no sign of which cell is being read. */
      .habits-cell:hover,
      .habits-cell.is-pinned { stroke: var(--fg); stroke-width: 1px; }
      .habits-chart text {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .habits-name { font-size: 11px; fill: var(--fg); }
      .habits-note, .habits-month { font-size: 9px; fill: var(--muted); }
      .habits-month { text-anchor: end; }
      .habits-tip {
        position: absolute;
        z-index: 5;
        transform: translate(-50%, -100%);
        pointer-events: none;
        background: var(--fg);
        color: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 0.72rem;
        line-height: 1.4;
        padding: 0.35rem 0.5rem;
        border-radius: 4px;
        white-space: nowrap;
        box-shadow: 0 1px 6px rgb(0 0 0 / 0.18);
      }
      .habits-tip b { display: block; font-weight: 600; }
      .habits-legend { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .habits-ramp {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        white-space: nowrap;
      }
      .habits-swatch {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 2px;
      }
      .habits-source { color: var(--muted); font-size: 0.85em; }
      .habits-empty { border-left: 2px solid var(--border); padding-left: 0.75rem; }
      /* Aperiodic tiling builder. Scoped to /maths/aperiodic-tiles, the second
         page that loads client-side JS: an interactive tiling needs a canvas.
         The --tile-* variables are read back out by the script so the drawing
         follows the light and dark palettes without duplicating them in JS. */
      .tiling {
        --tile-a: #f2e3d2;
        --tile-b: #d3a978;
        --tile-line: rgba(28, 28, 26, 0.42);
        --tile-bg: #fbfaf8;
        margin: 1.75rem 0 1.5rem;
      }
      @media (prefers-color-scheme: dark) {
        .tiling {
          --tile-a: #322b26;
          --tile-b: #8a5730;
          --tile-line: rgba(232, 230, 225, 0.28);
          --tile-bg: #121211;
        }
      }
      .tiling-stage { position: relative; }
      .tiling canvas {
        display: block;
        width: 100%;
        height: min(58vh, 30rem);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--tile-bg);
        cursor: grab;
        /* The canvas owns every gesture on it, so a drag pans instead of
           scrolling the page. Expand gives it the whole screen. */
        touch-action: none;
      }
      .tiling canvas.is-dragging { cursor: grabbing; }
      .tiling canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .tiling-zoom {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .tiling-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1.1rem;
        margin-top: 0.65rem;
      }
      .tiling-controls,
      .tiling figcaption {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .tiling-field {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .tiling-field[hidden] { display: none; }
      .tiling-field select,
      .tiling button {
        font: inherit;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      .tiling button { cursor: pointer; }
      .tiling button:hover { border-color: var(--accent); color: var(--accent); }
      .tiling-zoom button {
        width: 1.9rem;
        height: 1.9rem;
        padding: 0;
        font-size: 1rem;
        line-height: 1;
        background: var(--bg);
      }
      .tiling-buttons { gap: 0.4rem; }
      .tiling-field input[type="range"] {
        width: 8.5rem;
        accent-color: var(--accent);
      }
      .tiling-field output {
        min-width: 1.5rem;
        font-variant-numeric: tabular-nums;
        color: var(--fg);
      }
      .tiling-legend { display: inline-flex; flex-wrap: wrap; gap: 0.9rem; margin-left: 0.9rem; }
      .tiling-key { display: inline-flex; align-items: center; gap: 0.35rem; }
      .tiling-key i {
        width: 11px;
        height: 11px;
        border: 1px solid var(--tile-line);
        border-radius: 2px;
      }
      .tiling.is-expanded {
        position: fixed;
        inset: 0;
        z-index: 60;
        margin: 0;
        padding: 0.75rem;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .tiling.is-expanded .tiling-stage { flex: 1 1 auto; min-height: 0; }
      .tiling.is-expanded canvas { height: 100%; }
      .tiling.is-expanded figcaption { margin: 0; }
      body.tiling-locked { overflow: hidden; }
      /* A display equation too wide for the column scrolls in its own box
         rather than pushing the whole page sideways on a phone. */
      .katex-display { overflow-x: auto; overflow-y: hidden; padding: 2px 0; }
      /* Euler spiral viewer. Scoped to /maths/euler-spiral, the third page
         that loads client-side JS: a curve you can pan, zoom and trace needs a
         canvas. The --euler-* variables are read back out by the script, so the
         drawing follows the light and dark palettes without repeating them in
         JS. */
      .euler {
        --euler-curve: #8a4b2d;
        --euler-alt: #6b6b66;
        --euler-grid: rgba(28, 28, 26, 0.07);
        --euler-axis: rgba(28, 28, 26, 0.4);
        --euler-bg: #fbfaf8;
        margin: 1.75rem 0 1.5rem;
      }
      @media (prefers-color-scheme: dark) {
        .euler {
          --euler-curve: #d99a72;
          --euler-alt: #9a988f;
          --euler-grid: rgba(232, 230, 225, 0.07);
          --euler-axis: rgba(232, 230, 225, 0.38);
          --euler-bg: #121211;
        }
      }
      .euler-stage { position: relative; }
      .euler canvas {
        display: block;
        width: 100%;
        height: min(60vh, 31rem);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--euler-bg);
        cursor: grab;
        /* The canvas owns every gesture on it, so a drag pans instead of
           scrolling the page. Expand gives it the whole screen. */
        touch-action: none;
      }
      .euler canvas.is-dragging { cursor: grabbing; }
      .euler canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .euler-zoom {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .euler-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1.1rem;
        margin-top: 0.65rem;
      }
      .euler-controls,
      .euler figcaption {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .euler-field {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .euler-field[hidden] { display: none; }
      .euler-field select,
      .euler button {
        font: inherit;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      .euler button { cursor: pointer; }
      .euler button:hover { border-color: var(--accent); color: var(--accent); }
      .euler-zoom button {
        width: 1.9rem;
        height: 1.9rem;
        padding: 0;
        font-size: 1rem;
        line-height: 1;
        background: var(--bg);
      }
      .euler-buttons { gap: 0.4rem; }
      .euler-field input[type="range"] {
        width: 8.5rem;
        accent-color: var(--accent);
      }
      .euler-field output {
        min-width: 3.2rem;
        font-variant-numeric: tabular-nums;
        color: var(--fg);
      }
      .euler-readout { font-variant-numeric: tabular-nums; }
      .euler-legend { display: inline-flex; flex-wrap: wrap; gap: 0.9rem; margin-left: 0.9rem; }
      .euler-key { display: inline-flex; align-items: center; gap: 0.35rem; }
      .euler-key i {
        width: 11px;
        height: 3px;
        border-radius: 2px;
      }
      .euler.is-expanded {
        position: fixed;
        inset: 0;
        z-index: 60;
        margin: 0;
        padding: 0.75rem;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .euler.is-expanded .euler-stage { flex: 1 1 auto; min-height: 0; }
      .euler.is-expanded canvas { height: 100%; }
      .euler.is-expanded figcaption { margin: 0; }
      body.euler-locked { overflow: hidden; }
      /* Bertrand's paradox sampler. Scoped to /maths/bertrand-paradox, the
         fourth page that loads client-side JS: thousands of chords redrawn as a
         slider moves needs a canvas. Same arrangement as the two above — the
         --bert-* variables are read back out by the script, so the drawing
         follows the light and dark palettes without repeating them in JS. */
      .bertrand {
        --bert-long: #8a4b2d;
        --bert-short: #6b6b66;
        --bert-rim: rgba(28, 28, 26, 0.45);
        --bert-grid: rgba(28, 28, 26, 0.12);
        --bert-bg: #fbfaf8;
        margin: 1.75rem 0 1.5rem;
      }
      @media (prefers-color-scheme: dark) {
        .bertrand {
          --bert-long: #d99a72;
          --bert-short: #9a988f;
          --bert-rim: rgba(232, 230, 225, 0.42);
          --bert-grid: rgba(232, 230, 225, 0.12);
          --bert-bg: #121211;
        }
      }
      .bertrand canvas {
        display: block;
        width: 100%;
        height: min(60vh, 31rem);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--bert-bg);
      }
      .bertrand-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1.1rem;
        margin-top: 0.65rem;
      }
      .bertrand-controls,
      .bertrand figcaption {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .bertrand-field {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .bertrand-field select,
      .bertrand button {
        font: inherit;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      .bertrand button { cursor: pointer; }
      .bertrand button:hover { border-color: var(--accent); color: var(--accent); }
      .bertrand-buttons { gap: 0.4rem; }
      .bertrand-field input[type="range"] {
        width: 8.5rem;
        accent-color: var(--accent);
      }
      .bertrand-field output {
        min-width: 2.6rem;
        font-variant-numeric: tabular-nums;
        color: var(--fg);
      }
      .bertrand-readout { font-variant-numeric: tabular-nums; }
      .bertrand-legend { display: inline-flex; flex-wrap: wrap; gap: 0.9rem; margin-left: 0.9rem; }
      .bertrand-key { display: inline-flex; align-items: center; gap: 0.35rem; }
      .bertrand-key i {
        width: 11px;
        height: 3px;
        border-radius: 2px;
      }
      .bertrand.is-expanded {
        position: fixed;
        inset: 0;
        z-index: 60;
        margin: 0;
        padding: 0.75rem;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .bertrand.is-expanded canvas { flex: 1 1 auto; min-height: 0; height: 100%; }
      .bertrand.is-expanded figcaption { margin: 0; }
      body.bertrand-locked { overflow: hidden; }
      /* Mandelbrot viewer. Scoped to /maths/mandelbrot, the fifth page that
         loads client-side JS: a set defined by iterating every pixel has to be
         computed on the client, and pan and zoom are the whole point. Same
         arrangement as the three above — the --mandel-* variables are read back
         out by the script, with the five stops baked into its colour lookup
         table, so the drawing follows the light and dark palettes without
         repeating them in JS. */
      .mandel {
        --mandel-ink: #14100c;
        --mandel-s0: #fdf6ec;
        --mandel-s1: #d9a86a;
        --mandel-s2: #a8532a;
        --mandel-s3: #5b2d1c;
        --mandel-s4: #8f7f6a;
        --mandel-mark: #1c1c1a;
        --mandel-accent: #8a4b2d;
        --mandel-line: #6b6b66;
        --mandel-bg: #fbfaf8;
        margin: 1.75rem 0 1.5rem;
      }
      @media (prefers-color-scheme: dark) {
        .mandel {
          --mandel-ink: #0b0a09;
          --mandel-s0: #2a211c;
          --mandel-s1: #7c4423;
          --mandel-s2: #d99a72;
          --mandel-s3: #f2e0cb;
          --mandel-s4: #6d5b4a;
          --mandel-mark: #f4e9dc;
          --mandel-accent: #d99a72;
          --mandel-line: #9a988f;
          --mandel-bg: #121211;
        }
      }
      .mandel-stage { position: relative; }
      .mandel canvas {
        display: block;
        width: 100%;
        height: min(62vh, 32rem);
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--mandel-bg);
        cursor: grab;
        /* The canvas owns every gesture on it, so a drag pans instead of
           scrolling the page. Expand gives it the whole screen. */
        touch-action: none;
      }
      .mandel canvas.is-dragging { cursor: grabbing; }
      .mandel canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .mandel-zoom {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .mandel-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem 1.1rem;
        margin-top: 0.65rem;
      }
      .mandel-controls,
      .mandel figcaption {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      }
      .mandel-field {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--muted);
      }
      .mandel-field[hidden] { display: none; }
      .mandel-field select,
      .mandel button {
        font: inherit;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.2rem 0.5rem;
      }
      .mandel button { cursor: pointer; }
      .mandel button:hover { border-color: var(--accent); color: var(--accent); }
      .mandel button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
      .mandel-zoom button {
        width: 1.9rem;
        height: 1.9rem;
        padding: 0;
        font-size: 1rem;
        line-height: 1;
        background: var(--bg);
      }
      .mandel-buttons { gap: 0.4rem; }
      .mandel-field input[type="range"] {
        width: 8.5rem;
        accent-color: var(--accent);
      }
      .mandel-field output {
        min-width: 2.6rem;
        font-variant-numeric: tabular-nums;
        color: var(--fg);
      }
      .mandel-readout { font-variant-numeric: tabular-nums; }
      .mandel.is-expanded {
        position: fixed;
        inset: 0;
        z-index: 60;
        margin: 0;
        padding: 0.75rem;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .mandel.is-expanded .mandel-stage { flex: 1 1 auto; min-height: 0; }
      .mandel.is-expanded canvas { height: 100%; }
      .mandel.is-expanded figcaption { margin: 0; }
      body.mandel-locked { overflow: hidden; }
      footer.site {
        margin-top: 4rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 0.8rem;
        color: var(--muted);
      }
      footer.site a { color: var(--muted); }
      footer.site a:hover { color: var(--fg); }
    </style>
  </head>
  <body>
    <div class={wide ? "wrap wide" : "wrap"}>
      <header class="site">
        <a class="name" href="/">Owen Medeiros</a>
        <nav class="site">
          {nav.map((item) => (
            <a
              href={item.href}
              class={path === item.href || (item.href !== "/" && path.startsWith(item.href)) ? "active" : ""}
            >{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
