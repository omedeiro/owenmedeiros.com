---
import Base from "../layouts/Base.astro";
import running from "../data/habits/running.json";
import pushups from "../data/habits/pushups.json";
import commits from "../data/habits/commits.json";
import screentime from "../data/habits/screentime.json";
import stretching from "../data/habits/stretching.json";

// Geometry. One SVG holds the month gutter and every habit block so the rows
// stay locked together in a single scroll container. WEEKS is derived further
// down, once the data is in scope.
const CELL = 11;
const GAP = 3;
const PITCH = CELL + GAP;
const BLOCK_W = 7 * CELL + 6 * GAP;
const BLOCK_GAP = 26;
const GUTTER = 46;
const HEAD_H = 34;

type Day = { value: number; extra?: Record<string, number | string | boolean> };
type Habit = { label: string; source: string; unit: string; days: Record<string, Day> };

const DAY_NAMES = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

/** Format a fractional hour count as `6h 50m`. */
const hm = (hours: number) => {
  const mins = Math.round(hours * 60);
  return `${Math.floor(mins / 60)}h ${String(mins % 60).padStart(2, "0")}m`;
};

const HABITS = [
  {
    data: running as Habit,
    caption: "darker = further",
    empty: "no run",
    format: (d: Day) => {
      const miles = `${d.value.toFixed(1)} mi`;
      const secs = Number(d.extra?.moving_time_s) || 0;
      return secs ? `${miles} · ${Math.round(secs / 60)} min` : miles;
    },
    summary: (total: number) => `${total.toFixed(0)} mi total`,
  },
  {
    data: commits as Habit,
    caption: "darker = more",
    empty: "none",
    format: (d: Day) => `${d.value} commit${d.value === 1 ? "" : "s"}`,
    summary: (total: number) => `${total.toFixed(0)} total`,
  },
  {
    data: screentime as Habit,
    caption: "darker = more",
    empty: "none logged",
    format: (d: Day) => {
      const parts = [hm(d.value)];
      if (d.extra && (d.extra.mac_h || d.extra.iphone_h)) {
        parts.push(`Mac ${hm(Number(d.extra.mac_h) || 0)}`, `iPhone ${hm(Number(d.extra.iphone_h) || 0)}`);
      }
      return parts.join(" · ");
    },
    summary: (total: number, active: number) => `${hm(total / Math.max(active, 1))} a day`,
  },
  {
    data: stretching as Habit,
    caption: "darker = more",
    empty: "none",
    format: (d: Day) => {
      const parts = [`${d.value} session${d.value === 1 ? "" : "s"}`];
      // Days backfilled from Bend's history name the routine; days measured
      // through HealthKit know the duration instead.
      if (d.extra?.routines) parts.push(String(d.extra.routines));
      else if (d.extra?.minutes) parts.push(`${Math.round(Number(d.extra.minutes))} min`);
      return parts.join(" · ");
    },
    summary: (total: number) => `${total.toFixed(0)} sessions`,
  },
  {
    data: pushups as Habit,
    caption: "darker = more",
    empty: "none",
    format: (d: Day) => {
      const reps = `${d.value} rep${d.value === 1 ? "" : "s"}`;
      // Most days are a single set, and saying so on every one of them is noise;
      // the count only earns its place once a day holds more than one.
      const sessions = Number(d.extra?.count) || 1;
      return sessions > 1 ? `${reps} · ${sessions} sessions` : reps;
    },
    summary: (total: number) => `${total.toFixed(0)} reps total`,
  },
];

/** Local `YYYY-MM-DD`; `toISOString` would shift the date across UTC midnight. */
const dayKey = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

type Scale =
  | { kind: "discrete"; steps: number[] }
  | { kind: "quantile"; cuts: number[] };

/**
 * Work out how one habit's values map onto the five-step ramp.
 *
 * Scaling per habit rather than globally is what lets one column read a six-mile
 * run and another a 9-hour screen day on the same ramp.
 *
 * Habits with only a handful of distinct values get mapped directly onto the
 * steps instead of by quartile. Stretching is nearly always exactly one
 * session a day, and quartiles over a constant would put every active day on
 * the palest step — a column that looks empty when the habit is perfect.
 */
function scaleFor(days: Record<string, Day>): Scale | null {
  const values = Object.values(days).map((d) => d.value).filter((v) => v > 0).sort((a, b) => a - b);
  if (!values.length) return null;

  const distinct = [...new Set(values)];
  if (distinct.length <= 4) return { kind: "discrete", steps: distinct };

  const at = (p: number) => values[Math.min(values.length - 1, Math.floor(p * values.length))];
  return { kind: "quantile", cuts: [at(0.25), at(0.5), at(0.75)] };
}

function level(value: number, scale: Scale | null): number {
  if (!value || !scale) return 0;
  if (scale.kind === "discrete") {
    const found = scale.steps.indexOf(value);
    const rank = found >= 0 ? found + 1 : scale.steps.length;
    return Math.max(1, Math.round((rank / scale.steps.length) * 4));
  }
  const [q1, q2, q3] = scale.cuts;
  if (value <= q1) return 1;
  if (value <= q2) return 2;
  if (value <= q3) return 3;
  return 4;
}

const LEVEL_OPACITY = [0, 0.22, 0.44, 0.68, 1];

/** Consecutive-day streaks, walking the calendar from first record to today. */
function streaks(days: Record<string, Day>, today: Date) {
  const active = new Set(Object.keys(days).filter((k) => days[k].value > 0));
  if (!active.size) return { current: 0, longest: 0 };

  const first = new Date([...active].sort()[0] + "T00:00:00");
  let longest = 0;
  let run = 0;
  for (const cursor = new Date(first); cursor <= today; cursor.setDate(cursor.getDate() + 1)) {
    run = active.has(dayKey(cursor)) ? run + 1 : 0;
    longest = Math.max(longest, run);
  }

  // Today may simply not have synced yet, so a streak ending yesterday still counts.
  let current = 0;
  const cursor = new Date(today);
  if (!active.has(dayKey(cursor))) cursor.setDate(cursor.getDate() - 1);
  while (active.has(dayKey(cursor))) {
    current += 1;
    cursor.setDate(cursor.getDate() - 1);
  }
  return { current, longest };
}

const today = new Date();
today.setHours(0, 0, 0, 0);

// Row 0 is the current week, so scrolling down walks backwards through time.
const mondayOffset = (today.getDay() + 6) % 7;
const weekStart = new Date(today);
weekStart.setDate(today.getDate() - mondayOffset);

// Cover every day any habit has data for rather than a fixed window. Running
// reaches back years further than screen time does, and a hardcoded span would
// quietly clip the older end as history accumulates.
const earliestKey = HABITS
  .flatMap((habit) => Object.keys(habit.data.days))
  .reduce((a, b) => (a < b ? a : b), dayKey(today));
const earliestDate = new Date(`${earliestKey}T00:00:00`);
const spanDays = Math.max(
  0,
  Math.round((weekStart.getTime() - earliestDate.getTime()) / 86_400_000),
);
// One extra week so the oldest partial week is not cut off; a 52-week floor
// keeps the chart a sensible shape before any data arrives.
const WEEKS = Math.max(52, Math.ceil(spanDays / 7) + 1);

const rows = Array.from({ length: WEEKS }, (_, week) => {
  const cells = Array.from({ length: 7 }, (_, weekday) => {
    const date = new Date(weekStart);
    date.setDate(weekStart.getDate() - week * 7 + weekday);
    return {
      key: dayKey(date),
      future: date > today,
      label: `${DAY_NAMES[date.getDay()]} ${date.getDate()} ${MONTHS[date.getMonth()]} ${date.getFullYear()}`,
      startsMonth: date.getDate() === 1,
      month: date.getMonth(),
      year: date.getFullYear(),
    };
  });
  // A week is labelled by whichever day in it opens a new month.
  const opener = cells.find((c) => c.startsMonth);
  return {
    y: HEAD_H + week * PITCH,
    cells,
    monthLabel: opener ? (opener.month === 0 ? `${MONTHS[0]} ${String(opener.year).slice(2)}` : MONTHS[opener.month]) : null,
  };
});

const columns = HABITS.map((habit, index) => {
  const days = habit.data.days || {};
  const scale = scaleFor(days);
  const values = Object.values(days).map((d) => d.value).filter((v) => v > 0);
  const total = values.reduce((a, b) => a + b, 0);
  const { current, longest } = streaks(days, today);

  return {
    x: GUTTER + index * (BLOCK_W + BLOCK_GAP),
    label: habit.data.label,
    source: habit.data.source,
    caption: habit.caption,
    hasData: values.length > 0,
    scale,
    days,
    format: habit.format,
    empty: habit.empty,
    stats: {
      summary: values.length ? habit.summary(total, values.length) : "—",
      active: values.length,
      current,
      longest,
    },
  };
});

const width = GUTTER + columns.length * BLOCK_W + (columns.length - 1) * BLOCK_GAP;
const height = HEAD_H + WEEKS * PITCH;
const anyData = columns.some((c) => c.hasData);
const updated = [running, pushups, stretching, screentime, commits]
  .map((h) => h.updated_at)
  .filter(Boolean)
  .sort()
  .pop();
---

<Base title="Habits — Owen Medeiros" description="Daily habit tracking: running, push-ups, stretching, screen time, and commits." wide>
  <h1>Habits</h1>
  <p>
    Five things I track, back to {earliestKey.slice(0, 4)}. Each block is one habit; the seven
    cells across a row are Monday through Sunday, and each row down is a week
    further into the past. Hover or tap a cell for that day's numbers.
  </p>
  <p class="caption">
    Running and push-ups both come from Strava — the rep counts are posted
    there by the Puuush app — and commits from the GitHub contributions API;
    those refresh nightly. Screen time is read off my Mac and iPhone locally
    each night. Stretching leaves the Bend app through Apple Health, which a
    Shortcut on my phone pushes here; the routines Bend never writes to Health
    I fill in by hand. Each column starts when that source does.
    {updated && <> Last updated {String(updated).slice(0, 10)}.</>}
  </p>

  {!anyData && (
    <p class="caption habits-empty">
      No data yet — run the fetch scripts in <code>scripts/</code> to populate
      <code>src/data/habits/</code>.
    </p>
  )}

  <div class="habits-chart">
    <div class="habits-scroll">
      <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} role="img"
           aria-label={`Heatmaps of running, commits, screen time, stretching, and push-ups since ${earliestKey.slice(0, 4)}`}>
        {columns.map((column) => (
          <g>
            <text class="habits-name" x={column.x} y={12}>{column.label}</text>
            <text class="habits-note" x={column.x} y={24}>
              {column.hasData ? column.caption : "no data yet"}
            </text>
          </g>
        ))}

        {rows.map((row) => (
          <g>
            {row.monthLabel && (
              <text class="habits-month" x={GUTTER - 12} y={row.y + CELL - 1}>{row.monthLabel}</text>
            )}
            {columns.map((column) =>
              row.cells.map((cell, weekday) => {
                if (cell.future) return null;
                const record = column.days[cell.key];
                const step = level(record?.value ?? 0, column.scale);
                const detail = record && record.value > 0 ? column.format(record) : column.empty;
                return (
                  <rect
                    class="habits-cell"
                    x={column.x + weekday * PITCH}
                    y={row.y}
                    width={CELL}
                    height={CELL}
                    rx="2"
                    fill={step === 0 ? "var(--border)" : "var(--accent)"}
                    fill-opacity={step === 0 ? 1 : LEVEL_OPACITY[step]}
                    data-tip={`${cell.label}|${column.label} — ${detail}`}
                  />
                );
              })
            )}
          </g>
        ))}
      </svg>
    </div>
    <div class="habits-tip" hidden></div>
  </div>

  <p class="habits-legend caption">
    <span class="habits-ramp">
      Less
      <span class="habits-swatch" style="background: var(--border)"></span>
      <span class="habits-swatch" style="background: var(--accent); opacity: 0.22"></span>
      <span class="habits-swatch" style="background: var(--accent); opacity: 0.44"></span>
      <span class="habits-swatch" style="background: var(--accent); opacity: 0.68"></span>
      <span class="habits-swatch" style="background: var(--accent)"></span>
      More
    </span>
    <span>Shading is relative to each habit's own range.</span>
  </p>

  <h2>Summary</h2>
  <table>
    <thead>
      <tr>
        <th>Habit</th><th>Source</th><th>Amount</th><th>Days</th><th>Streak</th><th>Best</th>
      </tr>
    </thead>
    <tbody>
      {columns.map((column) => (
        <tr>
          <td>{column.label}</td>
          <td class="habits-source">{column.source}</td>
          <td>{column.stats.summary}</td>
          <td>{column.stats.active || "—"}</td>
          <td>{column.stats.current || "—"}</td>
          <td>{column.stats.longest || "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>

<script is:inline>
  // The only client-side JS on the site. Each cell carries its own preformatted
  // tooltip text, so this just positions a box — no formatting logic here.
  (function () {
    const chart = document.querySelector(".habits-chart");
    if (!chart) return;
    const tip = chart.querySelector(".habits-tip");
    const scroller = chart.querySelector(".habits-scroll");

    // The cell a tap has latched open, or null when nothing is pinned.
    let pinned = null;

    const isCell = (el) => el instanceof Element && el.classList.contains("habits-cell");

    function show(cell) {
      const raw = cell.getAttribute("data-tip") || "";
      const [when, what] = raw.split("|");
      tip.innerHTML = "";
      const head = document.createElement("b");
      head.textContent = when;
      tip.append(head, document.createTextNode(what || ""));
      tip.hidden = false;

      const box = cell.getBoundingClientRect();
      const frame = chart.getBoundingClientRect();

      // Clamp against the tooltip's real width so the long screen-time
      // breakdown can't run off either edge of the chart.
      const half = tip.offsetWidth / 2;
      const left = box.left - frame.left + box.width / 2;
      tip.style.left = Math.min(Math.max(left, half), frame.width - half) + "px";

      // Sits above the cell, but flips below for the top rows so it doesn't
      // cover the column headings.
      const above = box.top - frame.top - 6;
      const flip = above - tip.offsetHeight < 0;
      tip.style.top = (flip ? box.bottom - frame.top + 6 : above) + "px";
      tip.style.transform = flip ? "translate(-50%, 0)" : "translate(-50%, -100%)";
    }

    function hide() {
      tip.hidden = true;
      if (pinned) {
        pinned.classList.remove("is-pinned");
        pinned = null;
      }
    }

    // Mouse and trackpad: plain hover.
    chart.addEventListener("pointerover", (e) => {
      if (e.pointerType === "touch") return;
      if (isCell(e.target)) show(e.target);
    });
    chart.addEventListener("pointerleave", (e) => {
      // Touch pointers are destroyed on release, firing pointerleave straight
      // after pointerdown — which is why a tap used to flash the tooltip and
      // lose it again. Only a real pointer leaving should dismiss.
      if (e.pointerType === "touch") return;
      hide();
    });

    // Touch: a tap latches the tooltip open, since there is no hover to hold
    // it. Tapping the same cell closes it; tapping another moves it there.
    chart.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "touch" && e.pointerType !== "pen") return;
      if (!isCell(e.target)) return;
      const cell = e.target;
      const repeat = pinned === cell;
      hide();
      if (repeat) return;
      pinned = cell;
      cell.classList.add("is-pinned");
      show(cell);
    });

    // A tap anywhere else — including the gaps between blocks — dismisses it.
    // This runs after the handler above, so re-tapping a cell is unaffected.
    document.addEventListener("pointerdown", (e) => {
      if (pinned && !isCell(e.target)) hide();
    });

    // Scrolling the chart sideways moves the cells but leaves the tooltip
    // behind, so drop it. Vertical page scroll needs no handling: the tooltip
    // is positioned within the chart and travels with it.
    if (scroller) scroller.addEventListener("scroll", hide, { passive: true });
  })();
</script>
